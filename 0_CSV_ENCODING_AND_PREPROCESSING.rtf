from pathlib import Path\
\
inp = Path.home() / "Desktop" / "Limpieza_limpio_utf8.csv"\
out = Path.home() / "Desktop" / "Limpieza_limpio_utf8_fix.csv"\
\
with inp.open("r", encoding="utf-8", errors="replace", newline="") as f_in, \\\
     out.open("w", encoding="utf-8", newline="\\n") as f_out:\
\
    first = True\
    for line in f_in:\
        line = line.rstrip("\\n")\
\
        if first:\
            # Arreglos en header\
            line = line.replace("g\'8enero", "genero")\
            line = line.replace("star_date", "start_date")\
            if line.endswith(";"):\
                line = line[:-1]\
            f_out.write(line + "\\n")\
            first = False\
            continue\
\
        # Cada registro viene como:  "....";   => quitamos comilla inicial y el '";' final\
        if line.startswith('"') and line.endswith('";'):\
            line = line[1:-2]\
\
        # Dobles comillas "" -> "  (para que salary quede: " $77,719 ")\
        line = line.replace('""', '"')\
\
        f_out.write(line + "\\n")\
\
print("OK ->", out)\
PY\
